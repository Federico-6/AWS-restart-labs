
# ==========================================
# Python cache and compiled files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyd

# ==========================================
# Python virtual environments
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# Python build and packaging artifacts
# ==========================================
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example
!.env.sample

# AWS credentials and local configuration
.aws/
**/credentials
**/config

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Other sensitive files
secrets.*
secret.*
credentials.json
service-account*.json

# ==========================================
# AWS deployment artifacts
# ==========================================
.aws-sam/
.sam/
cdk.out/
.packages/

# ==========================================
# Local databases
# ==========================================
*.sqlite
*.sqlite3
*.db

# Keep SQL source files and scripts.
# Do not ignore *.sql globally.

# ==========================================
# VS Code
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ==========================================
# Other IDE files
# ==========================================
.idea/
*.code-workspace

# ==========================================
# Operating system files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
__MACOSX/

# ==========================================
# Logs and temporary files
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ==========================================
# Testing and code quality artifacts
# ==========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ==========================================
# Project-specific notes
# ==========================================
# Keep pymysql-v3/ if required by Lambda deployment.
# Keep prime-numbers-python/results.txt.
# Keep all .sql, .yaml, .md, .jpeg, and .draw.io files.
# No backup.sql exclusion is necessary.
